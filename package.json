{
  "name": "Semantic-MediaWiki-Graph",
  "version": "2.0.0",
  "description": "Enterprise-grade Semantic MediaWiki Graph visualization extension with TypeScript",
  "main": "webpack.config.js",
  "keywords": [
    "mediawiki",
    "semantic-mediawiki",
    "graph",
    "visualization",
    "d3",
    "typescript"
  ],
  "author": "Tobias Weller (original), Enterprise Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "watch": "webpack --watch",
    "clean": "tsc --build --clean",
    "lint": "eslint includes/js/**/*.{ts,js}",
    "lint:fix": "eslint includes/js/**/*.{ts,js} --fix",
    "format": "prettier --write includes/js/**/*.{ts,js}",
    "test": "jest",
    "test:watch": "jest --watch",
    "serve": "webpack serve"
  },
  "dependencies": {
    "d3": "^7.8.5",
    "jquery": "^3.6.3",
    "select2": "^4.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.0",
    "@types/jquery": "^3.5.14",
    "@types/node": "^18.11.18",
    "@types/select2": "^4.0",
    "@typescript-eslint/eslint-plugin": "^5.47.1",
    "@typescript-eslint/parser": "^5.47.1",
    "@webpack-cli/generators": "^3.0.1",
    "clean-webpack-plugin": "^4.0.0",
    "eslint": "^8.30.0",
    "jest": "^29.3.1",
    "prettier": "^2.8.1",
    "ts-loader": "^9.4.2",
    "types-mediawiki": "^1.3.0",
    "typescript": "^4.9.4",
    "update-resourceloader-config-plugin": "^2.0.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ]
  }
}
